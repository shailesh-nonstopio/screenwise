# Copy to .env for local development. Placeholders only — never commit real secrets.
# On Vercel, set these in Project Settings → Environment Variables.

# --- Core ---------------------------------------------------------------------
APP_ENV=development                 # development | production
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets; print(secrets.token_urlsafe(48))"
BASE_URL=http://localhost:8000      # public URL; used in invitation links (https://... in production)
DATABASE_URL=sqlite:///./screenwise.db
# Production (Vercel): a PostgreSQL URL, ideally the provider's *pooled* endpoint, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AUTO_MIGRATE=false                  # true = apply migrations on cold start (advisory-locked on Postgres)
DISPLAY_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# --- First administrator (created only if there are no users yet) --------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Candidate-facing details --------------------------------------------------
PRODUCT_NAME=Screenwise
COMPANY_NAME=Example Company
SUPPORT_EMAIL=recruiting@example.com
ACCESSIBILITY_EMAIL=accessibility@example.com
PRIVACY_EMAIL=privacy@example.com
RETENTION_DAYS=180
RESPONSE_DAYS=5 business days

# --- AI provider: mock | openai | anthropic -----------------------------------
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (e.g. Azure OpenAI proxy)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_PROVIDER_PUBLIC_NAME=            # optional: how the AI processor is named to candidates
LLM_TIMEOUT_SECONDS=45

# --- Email: dryrun | smtp | resend ---------------------------------------------
EMAIL_BACKEND=dryrun
EMAIL_FROM=Recruiting <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
RESEND_API_KEY=

# --- Uploads and interviews ----------------------------------------------------
MAX_UPLOAD_MB=4                     # Vercel limits request bodies to 4.5 MB
STORAGE_BACKEND=database            # database | local (local is not persistent on Vercel)
LOCAL_STORAGE_DIR=./var/uploads
INVITE_VALID_DAYS=5
MAX_ANSWER_CHARS=4000
REPORT_GENERATION=background        # background | inline | deferred (cron / "Generate now")

# --- Security ------------------------------------------------------------------
SESSION_MAX_AGE_HOURS=12
CRON_SECRET=                        # Vercel sends "Authorization: Bearer <CRON_SECRET>" to cron routes
RATE_LIMIT_PER_MINUTE=30
